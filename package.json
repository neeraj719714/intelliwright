{
  "name": "intelliwright",
  "version": "0.0.0",
  "description": "End-to-end testing for web apps, with page objects and Jev-powered checks, actions and failure triage.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "intelliwright": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "pretest": "npm run build",
    "test": "vitest run --project unit --project integration",
    "test:live": "vitest run --project live"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/babel__code-frame": "^7.27.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "preact": "^11.0.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": "./dist/index.js",
    "./ai-sdk": "./dist/ai-sdk.js",
    "./testing": "./dist/testing.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.7",
    "commander": "^14.0.3",
    "expect": "^30.5.2",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "playwright-core": "^1.63.0",
    "tinyglobby": "^0.2.17"
  }
}
